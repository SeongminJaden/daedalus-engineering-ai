# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- environment ---
.venv/
env/
.env

# --- run artifacts ---
# ANCHORED TO THE REPO ROOT (leading slash) on purpose. Unanchored patterns
# like "datasets/" match at ANY depth, which silently excluded the real source
# package surrogate/datasets/ from a commit - the push looked clean and a fresh
# clone could not import surrogate at all. Any generic directory name used for
# artifacts must be anchored, or it will eventually collide with a package.
/runs/
/logs/
/data/*
!/data/materials.yaml
/datasets/
/checkpoints/
/outputs/
/artifacts/
*.pt
*.pth
*.ckpt
*.npz
*.npy

# --- CAD output artifacts (the exporter is source; the files it writes
#     are run artifacts, regenerated from the design parameters) ---
*.step
*.stp
*.stl
*.iges
*.igs

# --- brain runtime database (schema lives in brain/db.py; the
#     accumulated experience is a run artifact, not source) ---
*.sqlite3
*.sqlite
*.db

# --- warp kernel cache ---
warp_cache/
.warp/

# --- editor / os ---
.vscode/
.idea/
.DS_Store
